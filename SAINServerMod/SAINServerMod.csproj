<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ModDir>SPT_Runtime\user\mods\$(Authors)-$(ModName)-ServerMod</ModDir>
        <InstallMod Condition="'$(InstallServerMod)' == 'True'">True</InstallMod>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SAIN.Preset.Shared\SAIN.Preset.Shared.csproj" />
        <ProjectReference Include="..\SAIN.ServerInterop\SAIN.ServerInterop.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SPTushonka.Common" Version="$(SPTPackageVersion)" />
        <PackageReference Include="SPTushonka.DI" Version="$(SPTPackageVersion)" />
        <PackageReference Include="SPTushonka.Reflection" Version="$(SPTPackageVersion)" />
        <PackageReference Include="SPTushonka.Server.Core" Version="$(SPTPackageVersion)" />
        <PackageReference Include="SPTushonka.Server.Web" Version="$(SPTPackageVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ModContent Include="Data\**" />
        <ModContent Include="wwwroot\**" />
    </ItemGroup>
</Project>
