<Project>

    <PropertyGroup>
        <Authors>Solarint</Authors>
        <ModName>SAIN</ModName>
        <ModGuid>me.sol.sain</ModGuid>
        <Version>4.5.1</Version>
        <ClientSPTVersion>4.1.3</ClientSPTVersion>
        <ServerSPTVersion>~4.1.3</ServerSPTVersion>
        <SPTPackageVersion>4.1.3</SPTPackageVersion>
        <PresetVersion>5.0.0</PresetVersion>
        <Product>$(ModName)</Product>
        <ReleaseDir>$(MSBuildThisFileDirectory)releases\$(Authors)-$(ModName)-$(Version)</ReleaseDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>None</DebugType>
        <GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>
</Project>
