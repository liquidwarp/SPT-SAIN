<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>disable</Nullable>
        <RootNamespace>SAIN</RootNamespace>
        <AssemblyName>SAIN</AssemblyName>
        <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
        <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
        <ModDir>BepInEx\plugins\$(ModName)</ModDir>
        <InstallMod Condition="'$(InstallClientMod)' == 'True'">True</InstallMod>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SAIN.Preset.Shared\SAIN.Preset.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
